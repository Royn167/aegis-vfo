# Server Configuration
NODE_ENV=development
PORT=3000
DOMAIN=localhost

# Database
DATABASE_URL=postgresql://aegis_user:aegis_password@localhost:5432/aegis_dev
POSTGRES_DB=aegis_dev
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=aegis_password

# Redis
REDIS_URL=redis://localhost:6379

# Security Keys (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-super-secret-encryption-key-32-chars
SESSION_SECRET=your-session-secret

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Admin User (for initial setup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=changeme123
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator